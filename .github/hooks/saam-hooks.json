{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node .github/hooks/saam-copilot-adapter.ts sessionStart",
        "powershell": "node .github/hooks/saam-copilot-adapter.ts sessionStart",
        "timeoutSec": 30
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "node .github/hooks/saam-copilot-adapter.ts preToolUse",
        "powershell": "node .github/hooks/saam-copilot-adapter.ts preToolUse",
        "timeoutSec": 30
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "node .github/hooks/saam-copilot-adapter.ts postToolUse",
        "powershell": "node .github/hooks/saam-copilot-adapter.ts postToolUse",
        "timeoutSec": 30
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "node .github/hooks/saam-copilot-adapter.ts agentStop",
        "powershell": "node .github/hooks/saam-copilot-adapter.ts agentStop",
        "timeoutSec": 15
      }
    ]
  }
}
